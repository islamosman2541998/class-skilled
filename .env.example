# Local development defaults (Laragon). For production values see DEPLOY.md:
# APP_ENV=production, APP_DEBUG=false, APP_URL=https://…, real DB and SMTP credentials.
APP_NAME="Class Skilled"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://class-skilled.test
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Dubai

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=class_skilled
DB_USERNAME=root
DB_PASSWORD=

# Shared hosting: file sessions/cache, no queue worker, no Redis.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production behind HTTPS: true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Full-page cache for guests (cleared automatically on every content change).
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_LIFETIME=604800

# Local: log. Production: smtp with the hosting mailbox.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@class-skilled.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

MEDIA_DISK=public
IMAGE_DRIVER=gd
QUEUE_CONVERSIONS_BY_DEFAULT=false
DEBUGBAR_ENABLED=false

# Dashboard URL prefix (not localized, never /admin).
ADMIN_PATH=cs-panel
# Initial administrator for the first `db:seed` only; never commit real credentials.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
